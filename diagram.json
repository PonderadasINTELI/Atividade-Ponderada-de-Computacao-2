    { "type": "wokwi-resistor", "id": "r1", "top": 140, "left": -150, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 175, "left": -150, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r3", "top": 210, "left": -150, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led_vermelho", "top": 90, "left": -260, "attrs": { "color": "red" } },
